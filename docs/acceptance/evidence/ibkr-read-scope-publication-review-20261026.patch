+
+    for name in ("reqPositions", "reqAllOpenOrders", "reqAccountSummary", "reqExecutions"):
+        setattr(ib.client, name, guarded_request(getattr(ib.client, name)))
+    original_updates = ib.client.reqAccountUpdates
