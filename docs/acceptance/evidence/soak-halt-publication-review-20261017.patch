--- a/tests/unit/soak_startup_test.py
+++ b/tests/unit/soak_startup_test.py
@@ -45,3 +45,183 @@ def test_startup_uses_full_budget_but_never_extends_it(monkeypatch, tmp_path, re
         with pytest.raises(RuntimeError, match="FIXTURE_STARTUP_BUDGET"):
             soak.start_server({"user": "fixture"}, tmp_path, {})
