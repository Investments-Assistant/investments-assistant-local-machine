diff --git a/tests/unit/route_error_logging_test.py b/tests/unit/route_error_logging_test.py
new file mode 100644
index 0000000..2619264
--- /dev/null
+++ b/tests/unit/route_error_logging_test.py
@@ -0,0 +1,39 @@
+"""Persistence failures must not copy request or provider data into logs."""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+from fastapi import HTTPException
+
+from src.web import routes
+
+
+@pytest.mark.parametrize(
+    "handler",
+    [
+        "update_broker_account",
+        "deactivate_broker_account",
+        "update_project",
+        "get_conversation",
+        "update_conversation",
+        "delete_conversation",
+    ],
+)
+async def test_persistence_error_logs_do_not_include_untrusted_details(handler, monkeypatch, caplog):
+    monkeypatch.setattr(
+        routes, "require_authenticated", AsyncMock(return_value=SimpleNamespace(user_id="fixture-user"))
+    )
+    context = MagicMock()
+    context.__aenter__ = AsyncMock(side_effect=RuntimeError("private-value\nFORGED audit success"))
+    monkeypatch.setattr(routes, "async_session", MagicMock(return_value=context))
+    request = SimpleNamespace(json=AsyncMock(return_value={"name": "fixture", "display_name": "fixture"}))
+    identifier = "87654321-1234-1234-1234-123456789012"
+    with pytest.raises(HTTPException) as caught:
+        await getattr(routes, handler)(identifier, request)
+    assert caught.value.status_code == 503
+    assert caplog.records, "The failure must remain observable"
+    assert "private-value" not in caplog.text
+    assert "FORGED" not in caplog.text
+    assert identifier not in caplog.text
+    assert "RuntimeError" in caplog.text
diff --git a/tests/unit/public_fetch_tls_test.py b/tests/unit/public_fetch_tls_test.py
new file mode 100644
index 0000000..95520e5
--- /dev/null
+++ b/tests/unit/public_fetch_tls_test.py
@@ -0,0 +1,82 @@
+"""Real TLS handshakes verify pinned HTTPS still authenticates certificates."""
+
+import ssl
+import socket
+from datetime import UTC, datetime, timedelta
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+from cryptography import x509
+from cryptography.x509.oid import NameOID
+from cryptography.hazmat.primitives import hashes, serialization
+from cryptography.hazmat.primitives.asymmetric import rsa
+
+from src.news.http import PinnedHTTPSConnection
+
+
+@pytest.mark.parametrize(
+    "hostname,trusted", [("fixture.example", True), ("wrong.example", True), ("fixture.example", False)]
+)
+def test_pinned_connection_validates_certificate_and_original_hostname(tmp_path, hostname, trusted):
+    key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
+    subject = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, "fixture.example")])
+    now = datetime.now(UTC)
+    certificate = (
+        x509.CertificateBuilder()
+        .subject_name(subject)
+        .issuer_name(subject)
+        .public_key(key.public_key())
+        .serial_number(x509.random_serial_number())
+        .not_valid_before(now - timedelta(minutes=1))
+        .not_valid_after(now + timedelta(hours=1))
+        .add_extension(x509.SubjectAlternativeName([x509.DNSName("fixture.example")]), critical=False)
+        .sign(key, hashes.SHA256())
+    )
+    cert_file, key_file = tmp_path / "cert.pem", tmp_path / "key.pem"
+    cert_file.write_bytes(certificate.public_bytes(serialization.Encoding.PEM))
+    key_file.write_bytes(
+        key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption())
+    )
+    server_context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+    server_context.load_cert_chain(cert_file, key_file)
+    server_names = []
+    server_context.set_servername_callback(lambda sock, name, context: server_names.append(name))
+    connection = PinnedHTTPSConnection(hostname, timeout=2)
+    assert connection._context.verify_mode == ssl.CERT_REQUIRED
+    assert connection._context.check_hostname
+    if trusted:
+        connection._context.load_verify_locations(cert_file)
+    with socket.socket() as listener:
+        listener.bind(("127.0.0.1", 0))
+        listener.listen(1)
+        listener.settimeout(3)
+
+        def serve():
+            raw, _ = listener.accept()
+            with raw:
+                raw.settimeout(3)
+                try:
+                    with server_context.wrap_socket(raw, server_side=True) as secure:
+                        secure.sendall(b"fixture")
+                except ssl.SSLError:
+                    # Expected peer alert for the two rejected certificates.
+                    return
+
+        # Redirect only this test connection's TCP transport to a local fixture.
+        # Production DNS/public-address policy is tested in public_fetch_test.
+        connection._create_connection = lambda address, timeout, source_address=None: socket.create_connection(
+            listener.getsockname(), timeout
+        )
+        with ThreadPoolExecutor(max_workers=1) as worker:
+            future = worker.submit(serve)
+            try:
+                if trusted and hostname == "fixture.example":
+                    connection.connect()
+                    assert connection.sock.recv(7) == b"fixture"
+                else:
+                    with pytest.raises(ssl.SSLCertVerificationError):
+                        connection.connect()
+            finally:
+                connection.close()
+                future.result(timeout=4)
+    assert server_names == [hostname]
diff --git a/tests/unit/dependency_security_test.py b/tests/unit/dependency_security_test.py
new file mode 100644
index 0000000..220f81c
--- /dev/null
+++ b/tests/unit/dependency_security_test.py
@@ -0,0 +1,23 @@
+"""Security contracts for dependency behavior used by retained adapters."""
+
+import jwt
+import pytest
+
+
+@pytest.mark.parametrize("algorithm", ["HS256", "HS384", "HS512"])
+def test_empty_hmac_jwk_cannot_be_used_to_verify_forged_tokens(algorithm):
+    # GHSA-pxh4-856f-4h89: an empty JWK must fail before token verification.
+    with pytest.raises(jwt.InvalidKeyError):
+        jwt.PyJWK.from_dict({"kty": "oct", "k": "", "alg": algorithm})
+
+
+def test_unverified_peek_cannot_disable_later_expiry_verification():
+    # GHSA-gvp8-978c-rx2q: caller-owned options must survive an unverified peek.
+    key = "synthetic-hmac-key-32-bytes-minimum-for-test"
+    expired = jwt.encode({"exp": 1, "sub": "fixture"}, key, algorithm="HS256")
+    options = {"verify_signature": False}
+    jwt.decode(expired, options=options)
+    assert options == {"verify_signature": False}
+    options["verify_signature"] = True
+    with pytest.raises(jwt.ExpiredSignatureError):
+        jwt.decode(expired, key, algorithms=["HS256"], options=options)
diff --git a/tests/unit/cookie_security_test.py b/tests/unit/cookie_security_test.py
new file mode 100644
index 0000000..754af65
--- /dev/null
+++ b/tests/unit/cookie_security_test.py
@@ -0,0 +1,41 @@
+"""Production cookie policy preserves session secrecy and double-submit CSRF."""
+
+from types import SimpleNamespace
+from http.cookies import SimpleCookie
+
+import pytest
+from fastapi import HTTPException
+
+from src.web import auth, routes
+from src.config import Settings
+
+
+def test_csrf_cookie_is_readable_but_never_a_session_credential(monkeypatch):
+    settings = Settings(
+        _env_file=None,
+        environment="production",
+        auth_require_login=True,
+        auth_cookie_secure=True,
+        auth_username="fixture",
+        auth_password_hash=auth.hash_password("synthetic-cookie-fixture-password"),
+        auth_session_secret="synthetic-cookie-security-fixture",
+    )
+    monkeypatch.setattr(routes, "settings", settings)
+    monkeypatch.setattr(auth.config, "settings", settings)
+    user = SimpleNamespace(id="fixture-user", username="fixture", display_name="Fixture")
+    response = routes._authenticated_response(user)
+    cookies = SimpleCookie()
+    for header in response.headers.getlist("set-cookie"):
+        cookies.load(header)
+    session, csrf = cookies[auth.SESSION_COOKIE], cookies[auth.CSRF_COOKIE]
+    assert session["httponly"]
+    assert not csrf["httponly"]  # Browser copies this value into X-CSRF-Token.
+    assert session["secure"] and csrf["secure"]
+    assert session["samesite"] == csrf["samesite"] == "strict"
+    assert auth.verify_session(session.value).user_id == user.id
+    assert auth.verify_session(csrf.value) is None
+    for headers in ({}, {"X-CSRF-Token": "wrong"}):
+        with pytest.raises(HTTPException) as caught:
+            auth.require_csrf(SimpleNamespace(cookies={auth.CSRF_COOKIE: csrf.value}, headers=headers))
+        assert caught.value.status_code == 403
+    auth.require_csrf(SimpleNamespace(cookies={auth.CSRF_COOKIE: csrf.value}, headers={"X-CSRF-Token": csrf.value}))
