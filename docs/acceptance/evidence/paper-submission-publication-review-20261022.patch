+                con_id=123, client_id=77, order_id=1, security_type="STK", exchange="IBIS2", currency="EUR",
+                side="buy", order_type="LMT", quantity="0.004", limit_price="100", tick="0.01", lot="0.001",
+                multiplier="1") | changes
